# REST vía YARP gateway (Umbral.Gateway). API directa sigue en :5000 para dev/debug.
VITE_API_URL=http://localhost:8000
# SignalR / hubs (debe apuntar a la API, no al gateway: YARP solo enruta /api/v1/**).
VITE_SIGNALR_URL=http://localhost:5000
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=umbral
VITE_KEYCLOAK_CLIENT_ID=umbral-web
# false = jugador solo en mobile. true = también /participante en web (legado).
VITE_PARTICIPANTE_WEB_ENABLED=false

# Bandeja SMTP local (Mailpit) para emails Keycloak al crear usuarios:
# UI:  http://localhost:8025
# SMTP: localhost:1025  (docker compose up mailpit -d)
