# REST vía YARP gateway (Umbral.Gateway). API directa sigue en :5000 para dev/debug.
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=umbral
VITE_KEYCLOAK_CLIENT_ID=umbral-web
# true = jugador puede usar /participante en web (E1). false cuando exista umbral-mobile.
VITE_PARTICIPANTE_WEB_ENABLED=true
