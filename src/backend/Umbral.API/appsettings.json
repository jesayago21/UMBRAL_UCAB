{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=umbral_db;Username=umbral_user;Password=umbral_pass"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "umbral_user",
    "Password": "umbral_pass"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/umbral",
    "Audience": "umbral-api",
    "RequireHttpsMetadata": false
  },
  "KeycloakAdmin": {
    "BaseUrl": "http://localhost:8080",
    "Realm": "umbral",
    "AdminTokenRealm": "master",
    "AdminClientId": "admin-cli",
    "AdminUsername": "admin",
    "AdminPassword": "admin",
    "UseDevStub": true,
    "FrontendClientId": "umbral-web",
    "FrontendRedirectUri": "http://localhost:5173/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
