# Copia este archivo a .env y ajusta los valores para tu entorno local.
# NUNCA commitees el archivo .env con credenciales reales.

# PostgreSQL
POSTGRES_DB=umbral_db
POSTGRES_USER=umbral_user
POSTGRES_PASSWORD=umbral_pass
POSTGRES_PORT=5433

# RabbitMQ
RABBITMQ_USER=umbral_user
RABBITMQ_PASS=umbral_pass

# API
ASPNETCORE_ENVIRONMENT=Development
